JWT_SECRET=dev-only-secret-change-me-please-32chars-min!!
GAME_MIN_PLAYERS_TO_START=2
UPSTREAM_TIMEOUT_MS=10000

# PostgreSQL credentials for the scaled services
ZOMBIE_DB_USER=zombies
ZOMBIE_DB_PASSWORD=zombies
RESOURCE_DB_USER=resources
RESOURCE_DB_PASSWORD=resources

# Image versions
VERSION=1.0.0
ZOMBIE_VERSION=1.1.0
RESOURCE_VERSION=1.1.0
ZOMBIE_REPLICAS=3
RESOURCE_REPLICAS=3

# Docker Hub username (used by `python3 run.py push --user <you>`)
DOCKERHUB_USER=
